---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import services from '../../content/services.json';
import settings from '../../content/settings.json';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://concept.jjhiggins.com/' },
    { '@type': 'ListItem', position: 2, name: 'Services', item: 'https://concept.jjhiggins.com/services/' },
  ],
};
---

<BaseLayout title="Services" description="Website design, chatbot creation, printing, and graphic design services from J. James Designs.">
  <Header slot="header" />

  <PageHero video="/video/hero-services.mp4" eyebrow="Our" title="services" />

  <section class="services-page">
    <div class="container">
      {services.rows.map((row, i) => (
        <div class={`service-row ${i % 2 === 1 ? 'is-reverse' : ''}`} data-reveal>
          <div class="service-text">
            <p class="service-kicker">
              <span class="service-kicker-word">{row.kickerWord}</span>
              {row.kickerSub && <span class="service-kicker-sub">{row.kickerSub}</span>}
            </p>
            <p class="service-copy">{row.copy}</p>
            {row.id === 'chatbot' ? (
              <a href={`tel:${settings.phoneHref}`} class="btn-outline is-dark btn-stacked">
                <span class="btn-primary">{settings.phone}</span>
                <span class="btn-secondary">Call For Pricing</span>
              </a>
            ) : (
              <a href="/request-a-quote/" class="btn-outline is-dark">Request A Quote</a>
            )}
          </div>
          <div class={`service-media ${row.images.length > 1 ? 'service-media-pair' : ''}`}>
            {row.images.map((src) => <img src={src} alt={`${row.kickerWord} ${row.kickerSub}`.trim()} loading="lazy" />)}
          </div>
        </div>
      ))}
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>

<style>
  .services-page {
    padding: 5rem 1.5rem 6rem;
  }

  .service-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 3rem;
    max-width: 1100px;
    margin: 0 auto;
    padding: 4rem 0;
    border-bottom: 1px solid #eee;
  }

  .service-row:last-child {
    border-bottom: none;
  }

  @media (min-width: 800px) {
    .service-row {
      flex-direction: row;
    }

    .service-row.is-reverse {
      flex-direction: row-reverse;
    }
  }

  .service-text {
    flex: 1 1 0;
    text-align: center;
  }

  @media (min-width: 800px) {
    .service-text {
      text-align: left;
    }
  }

  .service-media {
    flex: 1 1 0;
    width: 100%;
  }

  .service-media img {
    width: 100%;
    height: auto;
    display: block;
  }

  .service-media-pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }

  .service-media-pair img {
    height: 100%;
    object-fit: cover;
  }

  .service-kicker {
    margin: 0 0 1.5rem;
  }

  .service-kicker-word {
    display: block;
    color: var(--accent);
    text-transform: uppercase;
    font-weight: 800;
    font-size: 3rem;
    line-height: 1;
  }

  .service-kicker-sub {
    display: block;
    margin-top: 0.5rem;
    font-size: 1.15rem;
    letter-spacing: 0.7em;
    color: var(--text);
  }

  .service-copy {
    color: #444;
    margin-bottom: 2rem;
  }

  .btn-stacked {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.3;
  }

  .btn-primary {
    font-size: 1.2rem;
    font-weight: 700;
  }

  .btn-secondary {
    font-size: 0.85rem;
  }
</style>
